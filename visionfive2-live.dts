					#size-cells = <0x01>;
					compatible = "fixed-partitions";

					uboot-env@f0000 {
						reg = <0xf0000 0x10000>;
					};

					spl@0 {
						reg = <0x00 0xf0000>;
					};

					uboot@100000 {
						reg = <0x100000 0xf00000>;
					};
				};
			};
		};

		syscrg: clock-controller@13020000 {
			#reset-cells = <0x01>;
			clock-names = "osc", "gmac1_rmii_refin", "gmac1_rgmii_rxin", "i2stx_bclk_ext", "i2stx_lrck_ext", "i2srx_bclk_ext", "i2srx_lrck_ext", "tdm_ext", "mclk_ext", "pll0_out", "pll1_out", "pll2_out";
			assigned-clocks = <0x03 0x00 0x03 0x05 0x03 0x04 0x03 0x5a 0x03 0x01 0x28 0x00>;
			assigned-clock-parents = <0x28 0x00 0x28 0x02 0x28 0x02 0x03 0x59>;
			assigned-clock-rates = <0x00 0x00 0x00 0x00 0x1dcd6500 0x59682f00>;
			clocks = <0x20 0x26 0x27 0x23 0x24 0x19 0x1a 0x16 0x18 0x28 0x00 0x28 0x01 0x28 0x02>;
			#clock-cells = <0x01>;
			compatible = "starfive,jh7110-syscrg";
			reg = <0x00 0x13020000 0x00 0x10000>;
			bootph-pre-ram;
			phandle = <0x03>;
		};

		ccache: cache-controller@2010000 {
			cache-size = <0x200000>;
			cache-level = <0x02>;
			cache-sets = <0x800>;
			interrupts = <0x01 0x03 0x04 0x02>;
			cache-unified;
			compatible = "starfive,jh7110-ccache", "sifive,ccache0", "cache";
			reg = <0x00 0x2010000 0x00 0x4000>;
			phandle = <0x01>;
			cache-block-size = <0x40>;
		};

		pciephy0: phy@10210000 {
			starfive,sys-syscon = <0x1b 0x18>;
			starfive,stg-syscon = <0x1d 0x148 0x1f4>;
			#phy-cells = <0x00>;
			compatible = "starfive,jh7110-pcie-phy";
			reg = <0x00 0x10210000 0x00 0x10000>;
			phandle = <0x44>;
		};

		uart1: serial@10010000 {
			reg-io-width = <0x04>;
			clock-names = "baudclk", "apb_pclk";
			resets = <0x03 0x55 0x03 0x56>;
			interrupts = <0x21>;
			clocks = <0x03 0x94 0x03 0x93>;
			compatible = "starfive,jh7110-uart", "snps,dw-apb-uart";
			status = "disabled";
			reg = <0x00 0x10010000 0x00 0x10000>;
			phandle = <0x51>;
			reg-shift = <0x02>;
		};

		aongpio: pinctrl@17020000 {
			gpio-controller;
			resets = <0x2f 0x02>;
			interrupts = <0x55>;
			compatible = "starfive,jh7110-aon-pinctrl";
			#interrupt-cells = <0x02>;
			reg = <0x00 0x17020000 0x00 0x10000>;
			phandle = <0x49>;
			#gpio-cells = <0x02>;
			interrupt-controller;
		};

		i2c1: i2c@10040000 {
			#address-cells = <0x01>;
			clock-names = "ref";
			resets = <0x03 0x4d>;
			interrupts = <0x24>;
			clocks = <0x03 0x8b>;
			#size-cells = <0x00>;
			compatible = "snps,designware-i2c";
			status = "disabled";
			reg = <0x00 0x10040000 0x00 0x10000>;
			phandle = <0x54>;
		};

		stgcrg: clock-controller@10230000 {
			#reset-cells = <0x01>;
			clock-names = "osc", "hifi4_core", "stg_axiahb", "usb_125m", "cpu_bus", "hifi4_axi", "nocstg_bus", "apb_bus";
			clocks = <0x20 0x03 0x36 0x03 0x08 0x03 0x5f 0x03 0x02 0x03 0x37 0x03 0x06 0x03 0x0b>;
			#clock-cells = <0x01>;
			compatible = "starfive,jh7110-stgcrg";
			reg = <0x00 0x10230000 0x00 0x10000>;
			phandle = <0x1e>;
		};

		ispcrg: clock-controller@19810000 {
			power-domains = <0x37 0x05>;
			#reset-cells = <0x01>;
			clock-names = "isp_top_core", "isp_top_axi", "noc_bus_isp_axi", "dvp_clk";
			resets = <0x03 0x29 0x03 0x2a 0x03 0x1c>;
			clocks = <0x03 0x33 0x03 0x34 0x03 0x35 0x3a>;
			#clock-cells = <0x01>;
			compatible = "starfive,jh7110-ispcrg";
			reg = <0x00 0x19810000 0x00 0x10000>;
			phandle = <0x38>;
		};

		i2c6: i2c@12060000 {
			pinctrl-names = "default";
			#address-cells = <0x01>;
			i2c-sda-hold-time-ns = <0x12c>;
			pinctrl-0 = <0x22>;
			clock-names = "ref";
			i2c-scl-falling-time-ns = <0x1fe>;
			i2c-sda-falling-time-ns = <0x1fe>;
			resets = <0x03 0x52>;
			interrupts = <0x33>;
			clocks = <0x03 0x90>;
			#size-cells = <0x00>;
			clock-frequency = <0x186a0>;
			compatible = "snps,designware-i2c";
			status = "okay";
			reg = <0x00 0x12060000 0x00 0x10000>;
			phandle = <0x64>;
		};

		gmac1: ethernet@16040000 {
			snps,multicast-filter-bins = <0x40>;
			phy-mode = "rgmii-id";
			snps,txpbl = <0x10>;
			clock-names = "stmmaceth", "pclk", "ptp_ref", "tx", "gtx";
			assigned-clocks = <0x03 0x69>;
			assigned-clock-parents = <0x03 0x65>;
			local-mac-address = [6c cf 39 00 b7 47];
			snps,fixed-burst;
			resets = <0x03 0x42 0x03 0x43>;
			interrupts = <0x4e 0x4d 0x4c>;
			clocks = <0x03 0x62 0x03 0x61 0x03 0x66 0x03 0x6a 0x03 0x6b>;
			snps,no-pbl-x8;
			snps,tso;
			starfive,syscon = <0x1b 0x90 0x02>;
			snps,rxpbl = <0x10>;
			compatible = "starfive,jh7110-dwmac", "snps,dwmac-5.20";
			status = "okay";
			tx-fifo-depth = <0x800>;
			interrupt-names = "macirq", "eth_wake_irq", "eth_lpi";
			snps,force_thresh_dma_mode;
			rx-fifo-depth = <0x800>;
			reg = <0x00 0x16040000 0x00 0x10000>;
			phandle = <0x73>;
			phy-handle = <0x33>;
			reset-names = "stmmaceth", "ahb";
			snps,axi-config = <0x30>;
			starfive,tx-use-rgmii-clk;
			snps,perfect-filter-entries = <0x100>;

			mdio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "snps,dwmac-mdio";

				phy1: ethernet-phy@1 {
					rx-internal-delay-ps = <0x12c>;
					motorcomm,rx-clk-drv-microamp = <0xf82>;
					motorcomm,rx-data-drv-microamp = <0xb5e>;
					motorcomm,tx-clk-100-inverted;
					reg = <0x00>;
					phandle = <0x33>;
					tx-internal-delay-ps = <0x00>;
					motorcomm,tx-clk-adj-enabled;
				};
			};
		};

		spi6: spi@120a0000 {
			arm,primecell-periphid = <0x41022>;
			#address-cells = <0x01>;
			num-cs = <0x01>;
			clock-names = "sspclk", "apb_pclk";
			resets = <0x03 0x4b>;
			interrupts = <0x37>;
			clocks = <0x03 0x89 0x03 0x89>;
			#size-cells = <0x00>;
			compatible = "arm,pl022", "arm,primecell";
			status = "disabled";
			reg = <0x00 0x120a0000 0x00 0x10000>;
			phandle = <0x68>;
		};

		i2srx: i2s@100e0000 {
			clock-names = "i2sclk", "apb", "mclk", "mclk_inner", "mclk_ext", "bclk", "lrck", "bclk_ext", "lrck_ext";
			resets = <0x03 0x63 0x03 0x64>;
			clocks = <0x03 0xb0 0x03 0xaf 0x03 0x12 0x03 0x11 0x18 0x03 0xb3 0x03 0xb5 0x19 0x1a>;
			dma-names = "tx", "rx";
			#sound-dai-cells = <0x00>;
			starfive,syscon = <0x1b 0x18 0x02>;
			compatible = "starfive,jh7110-i2srx";
			status = "disabled";
			reg = <0x00 0x100e0000 0x00 0x1000>;
			phandle = <0x5a>;
			dmas = <0x00 0x17 0x18>;
		};

		watchdog@13070000 {
			clock-names = "apb", "core";
			resets = <0x03 0x6d 0x03 0x6e>;
			clocks = <0x03 0x7a 0x03 0x7b>;
			compatible = "starfive,jh7110-wdt";
			reg = <0x00 0x13070000 0x00 0x10000>;
		};

		gpu: gpu@18000000 {
			power-domains = <0x37 0x02>;
			dma-noncoherent;
			clock-names = "core", "sys", "mem", "core_clk", "apb", "rtc";
			resets = <0x03 0x15 0x03 0x16>;
			interrupts = <0x52>;
			clocks = <0x03 0x2d 0x03 0x2f 0x03 0x32 0x03 0x2e 0x03 0x30 0x03 0x31>;
			compatible = "starfive,jh7110-gpu", "img,img-bxe-4-32", "img,img-rogue";
			status = "okay";
			reg = <0x00 0x18000000 0x00 0x100000 0x00 0x130c000 0x00 0x10000>;
			phandle = <0x74>;
			reset-names = "apb", "doma";
		};

		i2stx1: i2s@120c0000 {
			clock-names = "i2sclk", "apb", "mclk", "mclk_inner", "mclk_ext", "bclk", "lrck", "bclk_ext", "lrck_ext";
			resets = <0x03 0x67 0x03 0x68>;
			clocks = <0x03 0xa9 0x03 0xa8 0x03 0x12 0x03 0x11 0x18 0x03 0xac 0x03 0xae 0x23 0x24>;
			dma-names = "tx";
			#sound-dai-cells = <0x00>;
			compatible = "starfive,jh7110-i2stx1";
			status = "disabled";
			reg = <0x00 0x120c0000 0x00 0x1000>;
			phandle = <0x6a>;
			dmas = <0x17 0x30>;
		};

		usb0: usb@10100000 {
			#address-cells = <0x01>;
			clock-names = "lpm", "stb", "apb", "axi", "utmi_apb";
			starfive,stg-syscon = <0x1d 0x04>;
			resets = <0x1e 0x0a 0x1e 0x08 0x1e 0x07 0x1e 0x09>;
			clocks = <0x1e 0x04 0x1e 0x05 0x1e 0x01 0x1e 0x03 0x1e 0x02>;
			#size-cells = <0x01>;
			compatible = "starfive,jh7110-usb";
			ranges = <0x00 0x00 0x10100000 0x100000>;
			status = "okay";
			phandle = <0x5b>;
			dr_mode = "peripheral";
			reset-names = "pwrup", "apb", "axi", "utmi_apb";

			usb_cdns3: usb@0 {
				phy-names = "cdns3,usb2-phy";
				reg-names = "otg", "xhci", "dev";
				interrupts = <0x64 0x6c 0x6e>;
				compatible = "cdns,usb3";
				interrupt-names = "host", "peripheral", "otg";
				phys = <0x1f>;
				reg = <0x00 0x10000 0x10000 0x10000 0x20000 0x10000>;
				phandle = <0x5c>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_power: led-0 {
			phandle = <0x7f>;
			gpios = <0x49 0x03 0x00>;
		};
	};

	dvp_clk: dvp-clock {
		clock-output-names = "dvp_clk";
		#clock-cells = <0x00>;
		clock-frequency = <0x46cf710>;
		compatible = "fixed-clock";
		phandle = <0x3a>;
	};

	i2srx_lrck_ext: i2srx-lrck-ext-clock {
		clock-output-names = "i2srx_lrck_ext";
		#clock-cells = <0x00>;
		clock-frequency = <0x2ee00>;
		compatible = "fixed-clock";
		phandle = <0x1a>;
	};

	gpio-restart {
		priority = <0xe0>;
		compatible = "gpio-restart";
		gpios = <0x2e 0x23 0x00>;
	};

	tdm_ext: tdm-ext-clock {
		clock-output-names = "tdm_ext";
		#clock-cells = <0x00>;
		clock-frequency = <0x2ee0000>;
		compatible = "fixed-clock";
		phandle = <0x16>;
	};

	mclk_ext: mclk-ext-clock {
		clock-output-names = "mclk_ext";
		#clock-cells = <0x00>;
		clock-frequency = <0xbb8000>;
		compatible = "fixed-clock";
		phandle = <0x18>;
	};

	cpu_opp: opp-table-0 {
		opp-shared;
		compatible = "operating-points-v2";
		phandle = <0x02>;

		opp-500000000 {
			opp-microvolt = "", "\f5";
			opp-hz = <0x00 0x1dcd6500>;
		};

		opp-750000000 {
			opp-microvolt = "", "\f5";
			opp-hz = <0x00 0x2cb41780>;
		};

		opp-1500000000 {
			opp-microvolt = <0xfde80>;
			opp-hz = <0x00 0x59682f00>;
		};

		opp-375000000 {
			opp-microvolt = "", "\f5";
			opp-hz = <0x00 0x165a0bc0>;
		};
	};

	aliases {
		ethernet0 = "/soc/ethernet@16030000";
		mmc1 = "/soc/mmc@16020000";
		i2c6 = "/soc/i2c@12060000";
		ethernet1 = "/soc/ethernet@16040000";
		i2c2 = "/soc/i2c@10050000";
		i2c0 = "/soc/i2c@10030000";
		mmc0 = "/soc/mmc@16010000";
		i2c5 = "/soc/i2c@12050000";
		serial0 = "/soc/serial@10000000";
	};

	sound {
		simple-audio-card,name = "StarFive-PWMDAC-Sound-Card";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "simple-audio-card";

		simple-audio-card,dai-link@0 {
			format = "left_j";
			frame-master = <0x4a>;
			bitclock-master = <0x4a>;
			reg = <0x00>;

			sndcpu0: cpu {
				phandle = <0x4a>;
				sound-dai = <0x4b>;
			};

			codec {
				sound-dai = <0x4c>;
			};
		};
	};

	i2stx_bclk_ext: i2stx-bclk-ext-clock {
		clock-output-names = "i2stx_bclk_ext";
		#clock-cells = <0x00>;
		clock-frequency = <0xbb8000>;
		compatible = "fixed-clock";
		phandle = <0x23>;
	};

	gmac0_rmii_refin: gmac0-rmii-refin-clock {
		clock-output-names = "gmac0_rmii_refin";
		#clock-cells = <0x00>;
		clock-frequency = <0x2faf080>;
		compatible = "fixed-clock";
		phandle = <0x34>;
	};

	chosen {
		linux,uefi-mmap-size = <0x4d8>;
		u-boot,version = "2025.01-3";
		bootargs = "BOOT_IMAGE=/boot/vmlinuz-7.3.0-rc5-lzzhzhcfg root=UUID=d0dbffd1-b19d-448b-8263-42049531bd8a ro quiet modprobe.blacklist=powervr cma=128M";
		boot-hartid = <0x02>;
		linux,uefi-mmap-start = <0x00 0xfe6de068>;
		linux,uefi-mmap-desc-size = <0x28>;
		linux,uefi-mmap-desc-ver = <0x01>;
		linux,uefi-system-table = <0x00 0xfff46fd0>;
		stdout-path = "serial0:115200n8";
	};

	gmac0_rgmii_rxin: gmac0-rgmii-rxin-clock {
		clock-output-names = "gmac0_rgmii_rxin";
		#clock-cells = <0x00>;
		clock-frequency = <0x7735940>;
		compatible = "fixed-clock";
		phandle = <0x35>;
	};

	cpus: cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = "", "=\t";
		phandle = <0x4e>;

		U74_1: cpu@1 {
			i-tlb-sets = <0x01>;
			clock-names = "cpu";
			cpu-supply = <0x04>;
			clocks = <0x03 0x01>;
			d-cache-block-size = <0x40>;
			device_type = "cpu";
			compatible = "sifive,u74-mc", "riscv";
			mmu-type = "riscv,sv39";
			d-cache-size = <0x8000>;
			next-level-cache = <0x01>;
			riscv,isa-base = "rv64i";
			i-cache-size = <0x8000>;
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zba", "zbb", "zicntr", "zicsr", "zifencei", "zihpm";
			reg = <0x01>;
			phandle = <0x06>;
			d-cache-sets = <0x40>;
			i-cache-block-size = <0x40>;
			operating-points-v2 = <0x02>;
			i-cache-sets = <0x40>;
			d-tlb-size = <0x28>;
			riscv,isa = "rv64imafdc_zba_zbb";
			tlb-split;
			i-tlb-size = <0x28>;
			d-tlb-sets = <0x01>;
			#cooling-cells = <0x02>;

			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <0x01>;
				bootph-pre-ram;
				phandle = <0x0e>;
				interrupt-controller;
			};
		};

		U74_4: cpu@4 {
			i-tlb-sets = <0x01>;
			clock-names = "cpu";
			cpu-supply = <0x04>;
			clocks = <0x03 0x01>;
			d-cache-block-size = <0x40>;
			device_type = "cpu";
			compatible = "sifive,u74-mc", "riscv";
			mmu-type = "riscv,sv39";
			d-cache-size = <0x8000>;
			next-level-cache = <0x01>;
			riscv,isa-base = "rv64i";
			i-cache-size = <0x8000>;
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zba", "zbb", "zicntr", "zicsr", "zifencei", "zihpm";
			reg = <0x04>;
			phandle = <0x09>;
			d-cache-sets = <0x40>;
			i-cache-block-size = <0x40>;
			operating-points-v2 = <0x02>;
			i-cache-sets = <0x40>;
			d-tlb-size = <0x28>;
			riscv,isa = "rv64imafdc_zba_zbb";
			tlb-split;
			i-tlb-size = <0x28>;
			d-tlb-sets = <0x01>;
			#cooling-cells = <0x02>;

			cpu4_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <0x01>;
				bootph-pre-ram;
				phandle = <0x11>;
				interrupt-controller;
			};
		};

		cpu-map {

			cluster0 {

				core3 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x06>;
				};

				core4 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x07>;
				};

				core0 {
					cpu = <0x05>;
				};
			};
		};

		U74_2: cpu@2 {
			i-tlb-sets = <0x01>;
			clock-names = "cpu";
			cpu-supply = <0x04>;
			clocks = <0x03 0x01>;
			d-cache-block-size = <0x40>;
			device_type = "cpu";
			compatible = "sifive,u74-mc", "riscv";
			mmu-type = "riscv,sv39";
			d-cache-size = <0x8000>;
			next-level-cache = <0x01>;
			riscv,isa-base = "rv64i";
			i-cache-size = <0x8000>;
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zba", "zbb", "zicntr", "zicsr", "zifencei", "zihpm";
			reg = <0x02>;
			phandle = <0x07>;
			d-cache-sets = <0x40>;
			i-cache-block-size = <0x40>;
			operating-points-v2 = <0x02>;
			i-cache-sets = <0x40>;
			d-tlb-size = <0x28>;
			riscv,isa = "rv64imafdc_zba_zbb";
			tlb-split;
			i-tlb-size = <0x28>;
			d-tlb-sets = <0x01>;
			#cooling-cells = <0x02>;

			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <0x01>;
				bootph-pre-ram;
				phandle = <0x0f>;
				interrupt-controller;
			};
		};

		S7_0: cpu@0 {
			device_type = "cpu";
			compatible = "sifive,s7", "riscv";
			status = "disabled";
			next-level-cache = <0x01>;
			riscv,isa-base = "rv64i";
			i-cache-size = <0x4000>;
			riscv,isa-extensions = "i", "m", "a", "c", "zba", "zbb", "zicntr", "zicsr", "zifencei", "zihpm";
			reg = <0x00>;
			phandle = <0x05>;
			i-cache-block-size = <0x40>;
			i-cache-sets = <0x40>;
			riscv,isa = "rv64imac_zba_zbb";

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <0x01>;
				bootph-pre-ram;
				phandle = <0x0d>;
				interrupt-controller;
			};
		};

		U74_3: cpu@3 {
			i-tlb-sets = <0x01>;
			clock-names = "cpu";
			cpu-supply = <0x04>;
			clocks = <0x03 0x01>;
			d-cache-block-size = <0x40>;
			device_type = "cpu";
			compatible = "sifive,u74-mc", "riscv";
			mmu-type = "riscv,sv39";
			d-cache-size = <0x8000>;
			next-level-cache = <0x01>;
			riscv,isa-base = "rv64i";
			i-cache-size = <0x8000>;
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zba", "zbb", "zicntr", "zicsr", "zifencei", "zihpm";
			reg = <0x03>;
			phandle = <0x08>;
			d-cache-sets = <0x40>;
			i-cache-block-size = <0x40>;
			operating-points-v2 = <0x02>;
			i-cache-sets = <0x40>;
			d-tlb-size = <0x28>;
			riscv,isa = "rv64imafdc_zba_zbb";
			tlb-split;
			i-tlb-size = <0x28>;
			d-tlb-sets = <0x01>;
			#cooling-cells = <0x02>;

			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <0x01>;
				bootph-pre-ram;
				phandle = <0x10>;
				interrupt-controller;
			};
		};
	};

