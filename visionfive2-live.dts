/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "StarFive VisionFive 2 v1.3B";
	serial-number = "VF7110B1-2318-D008E000-18004700";
	#size-cells = <0x02>;
	compatible = "starfive,visionfive-2-v1.3b", "starfive,jh7110";

	xin24m: xin24m-clock {
		clock-output-names = "xin24m";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		compatible = "fixed-clock";
		phandle = <0x42>;
	};

	osc: oscillator {
		clock-output-names = "osc";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		compatible = "fixed-clock";
		bootph-pre-ram;
		phandle = <0x20>;
	};

	i2stx_lrck_ext: i2stx-lrck-ext-clock {
		clock-output-names = "i2stx_lrck_ext";
		#clock-cells = <0x00>;
		clock-frequency = <0x2ee00>;
		compatible = "fixed-clock";
		phandle = <0x24>;
	};

	stmmac_axi_setup: stmmac-axi-config {
		snps,lpi_en;
		snps,wr_osr_lmt = <0x0f>;
		phandle = <0x30>;
		snps,blen = <0x100 0x80 0x40 0x20 0x00 0x00 0x00>;
		snps,rd_osr_lmt = <0x0f>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x02 0x00>;
		bootph-pre-ram;
	};

	gmac1_rmii_refin: gmac1-rmii-refin-clock {
		clock-output-names = "gmac1_rmii_refin";
		#clock-cells = <0x00>;
		clock-frequency = <0x2faf080>;
		compatible = "fixed-clock";
		bootph-pre-ram;
		phandle = <0x26>;
	};

	rtc_osc: rtc-oscillator {
		clock-output-names = "rtc_osc";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		compatible = "fixed-clock";
		phandle = <0x36>;
	};

	thermal-zones {

		cpu-thermal {
			polling-delay = <0x3a98>;
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x0a>;

			trips {

				cpu-crit {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};

				cpu_alert0: cpu-alert0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x0b>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0b>;
					cooling-device = <0x06 0xffffffff 0xffffffff 0x07 0xffffffff 0xffffffff 0x08 0xffffffff 0xffffffff 0x09 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	gmac1_rgmii_rxin: gmac1-rgmii-rxin-clock {
		clock-output-names = "gmac1_rgmii_rxin";
		#clock-cells = <0x00>;
		clock-frequency = <0x7735940>;
		compatible = "fixed-clock";
		bootph-pre-ram;
		phandle = <0x27>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		interrupt-parent = <0x0c>;
		compatible = "simple-bus";
		ranges;

		spi3: spi@12070000 {
			arm,primecell-periphid = <0x41022>;
			#address-cells = <0x01>;
			num-cs = <0x01>;
			clock-names = "sspclk", "apb_pclk";
			resets = <0x03 0x48>;
			interrupts = <0x34>;
			clocks = <0x03 0x86 0x03 0x86>;
			#size-cells = <0x00>;
			compatible = "arm,pl022", "arm,primecell";
			status = "disabled";
			reg = <0x00 0x12070000 0x00 0x10000>;
			phandle = <0x65>;
		};

		pciephy1: phy@10220000 {
			#phy-cells = <0x00>;
			compatible = "starfive,jh7110-pcie-phy";
			reg = <0x00 0x10220000 0x00 0x10000>;
			phandle = <0x47>;
		};

		csi2rx: csi@19800000 {
			phy-names = "dphy";
			clock-names = "sys_clk", "p_clk", "pixel_if0_clk", "pixel_if1_clk", "pixel_if2_clk", "pixel_if3_clk";
			assigned-clocks = <0x38 0x07>;
			assigned-clock-rates = <0x11b3dc40>;
			resets = <0x38 0x09 0x38 0x04 0x38 0x05 0x38 0x06 0x38 0x07 0x38 0x08>;
			clocks = <0x38 0x07 0x38 0x06 0x38 0x08 0x38 0x09 0x38 0x0a 0x38 0x0b>;
			compatible = "starfive,jh7110-csi2rx", "cdns,csi2rx";
			status = "disabled";
			phys = <0x39>;
			reg = <0x00 0x19800000 0x00 0x10000>;
			phandle = <0x75>;
			reset-names = "sys", "reg_bank", "pixel_if0", "pixel_if1", "pixel_if2", "pixel_if3";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
				};

				port@1 {
					reg = <0x01>;
				};
			};
		};

		uart2: serial@10020000 {
			reg-io-width = <0x04>;
			clock-names = "baudclk", "apb_pclk";
			resets = <0x03 0x57 0x03 0x58>;
			interrupts = <0x22>;
			clocks = <0x03 0x96 0x03 0x95>;
			compatible = "starfive,jh7110-uart", "snps,dw-apb-uart";
			status = "disabled";
			reg = <0x00 0x10020000 0x00 0x10000>;
			phandle = <0x52>;
			reg-shift = <0x02>;
		};

		sys_syscon: syscon@13030000 {
			compatible = "starfive,jh7110-sys-syscon", "syscon", "simple-mfd";
			reg = <0x00 0x13030000 0x00 0x1000>;
			phandle = <0x1b>;

			pllclk: clock-controller {
				clocks = <0x20>;
				#clock-cells = <0x01>;
				compatible = "starfive,jh7110-pll";
				bootph-pre-ram;
				phandle = <0x28>;
			};
		};

		memory-controller@15700000 {
			clock-names = "pll";
			resets = <0x03 0x26 0x03 0x27 0x03 0x28>;
			clocks = <0x03 0x01>;
			compatible = "starfive,jh7110-dmc";
			reg = <0x00 0x15700000 0x00 0x10000 0x00 0x13000000 0x00 0x10000>;
			bootph-pre-ram;
			reset-names = "axi", "osc", "apb";
		};

		i2c2: i2c@10050000 {
			pinctrl-names = "default";
			#address-cells = <0x01>;
			i2c-sda-hold-time-ns = <0x12c>;
			pinctrl-0 = <0x14>;
			clock-names = "ref";
			i2c-scl-falling-time-ns = <0x1fe>;
			i2c-sda-falling-time-ns = <0x1fe>;
			resets = <0x03 0x4e>;
			interrupts = <0x25>;
			clocks = <0x03 0x8c>;
			#size-cells = <0x00>;
			clock-frequency = <0x186a0>;
			compatible = "snps,designware-i2c";
			status = "okay";
			reg = <0x00 0x10050000 0x00 0x10000>;
			phandle = <0x55>;
		};

		uart3: serial@12000000 {
			reg-io-width = <0x04>;
			clock-names = "baudclk", "apb_pclk";
			resets = <0x03 0x59 0x03 0x5a>;
			interrupts = <0x2d>;
			clocks = <0x03 0x98 0x03 0x97>;
			compatible = "starfive,jh7110-uart", "snps,dw-apb-uart";
			status = "disabled";
			reg = <0x00 0x12000000 0x00 0x10000>;
			phandle = <0x5d>;
			reg-shift = <0x02>;
		};

		sdma: dma-controller@16008000 {
			memcpy-bus-width = <0x20>;
			arm,primecell-periphid = <0x41080>;
			lli-bus-interface-ahb1;
			clock-names = "apb_pclk";
			resets = <0x1e 0x03>;
			interrupts = <0x1d>;
			clocks = <0x1e 0x0f>;
			memcpy-burst-size = <0x100>;
			compatible = "arm,pl080", "arm,primecell";
			mem-bus-interface-ahb1;
			reg = <0x00 0x16008000 0x00 0x4000>;
			phandle = <0x29>;
			#dma-cells = <0x02>;
		};

		i2c3: i2c@12030000 {
			#address-cells = <0x01>;
			clock-names = "ref";
			resets = <0x03 0x4f>;
			interrupts = <0x30>;
			clocks = <0x03 0x8d>;
			#size-cells = <0x00>;
			compatible = "snps,designware-i2c";
			status = "disabled";
			reg = <0x00 0x12030000 0x00 0x10000>;
			phandle = <0x60>;
		};

		dma: dma-controller@16050000 {
			snps,data-width = <0x03>;
			snps,priority = <0x00 0x01 0x02 0x03>;
			clock-names = "core-clk", "cfgr-clk";
			resets = <0x1e 0x05 0x1e 0x06>;
			interrupts = <0x49>;
			clocks = <0x1e 0x1b 0x1e 0x1c>;
			snps,axi-max-burst-len = <0x10>;
			snps,dma-masters = <0x01>;
			compatible = "starfive,jh7110-axi-dma";
			snps,block-size = <0x10000 0x10000 0x10000 0x10000>;
			reg = <0x00 0x16050000 0x00 0x10000>;
			phandle = <0x17>;
			dma-channels = <0x04>;
			#dma-cells = <0x01>;
		};

		pwm: pwm@120d0000 {
			pinctrl-names = "default";
			pinctrl-0 = <0x25>;
			resets = <0x03 0x6c>;
			clocks = <0x03 0x79>;
			#pwm-cells = <0x03>;
			compatible = "starfive,jh7110-pwm", "opencores,pwm-v1";
			status = "okay";
			reg = <0x00 0x120d0000 0x00 0x10000>;
			phandle = <0x6b>;
		};

		stg_syscon: syscon@10240000 {
			compatible = "starfive,jh7110-stg-syscon", "syscon";
			reg = <0x00 0x10240000 0x00 0x1000>;
			phandle = <0x1d>;
		};

		spi0: spi@10060000 {
			arm,primecell-periphid = <0x41022>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			num-cs = <0x01>;
			pinctrl-0 = <0x15>;
			clock-names = "sspclk", "apb_pclk";
			resets = <0x03 0x45>;
			interrupts = <0x26>;
			clocks = <0x03 0x83 0x03 0x83>;
			#size-cells = <0x00>;
			compatible = "arm,pl022", "arm,primecell";
			status = "okay";
			reg = <0x00 0x10060000 0x00 0x10000>;
			phandle = <0x56>;
		};

		pwmdac: pwmdac@100b0000 {
			pinctrl-names = "default";
			pinctrl-0 = <0x1c>;
			clock-names = "apb", "core";
			resets = <0x03 0x60>;
			clocks = <0x03 0x9d 0x03 0x9e>;
			dma-names = "tx";
			#sound-dai-cells = <0x00>;
			compatible = "starfive,jh7110-pwmdac";
			status = "okay";
			reg = <0x00 0x100b0000 0x00 0x1000>;
			phandle = <0x4b>;
			dmas = <0x17 0x16>;
		};

		sysgpio: pinctrl@13040000 {
			gpio-controller;
			resets = <0x03 0x02>;
			interrupts = <0x56>;
			clocks = <0x03 0x70>;
			compatible = "starfive,jh7110-sys-pinctrl";
			#interrupt-cells = <0x02>;
			reg = <0x00 0x13040000 0x00 0x10000>;
			phandle = <0x2e>;
			#gpio-cells = <0x02>;
			interrupt-controller;

			mmc1_pins: mmc1-0 {
				phandle = <0x2d>;

				clk-pins {
					input-schmitt-disable;
					input-disable;
					drive-strength = <0x0c>;
					pinmux = <0xff37000a>;
					slew-rate = <0x00>;
					bias-pull-up;
				};

				mmc-pins {
					drive-strength = <0x0c>;
					pinmux = <0x2c394c09 0x2d3a500b 0x2e3b540c 0x2f3c5807 0x303d5c08>;
					input-schmitt-enable;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};

			i2c2_pins: i2c2-0 {
				phandle = <0x14>;

				i2c-pins {
					bias-disable;
					pinmux = <0x3b007803 0x3c007c02>;
					input-schmitt-enable;
					input-enable;
				};
			};

			i2c5_pins: i2c5-0 {
				bootph-pre-ram;
				phandle = <0x21>;

				i2c-pins {
					bias-disable;
					pinmux = <0x4f00a813 0x5000ac14>;
					input-schmitt-enable;
					bootph-pre-ram;
					input-enable;
				};
			};

			spi0_pins: spi0-0 {
				phandle = <0x15>;

				miso-pins {
					pinmux = <0x1c000435>;
					input-schmitt-enable;
					bias-pull-up;
					input-enable;
				};

				mosi-pins {
					input-schmitt-disable;
					input-disable;
					bias-disable;
					pinmux = <0xff200034>;
				};

				ss-pins {
					input-schmitt-disable;
					input-disable;
					bias-disable;
					pinmux = <0x1b1f0031>;
				};

				sck-pins {
					input-schmitt-disable;
					input-disable;
					bias-disable;
					pinmux = <0x1a1e0030>;
				};
			};

			mmc0_pins: mmc0-0 {
				phandle = <0x2a>;

				mmc-pins {
					drive-strength = <0x0c>;
					pinmux = <0x440 0x441 0x442 0x443 0x444 0x445 0x446 0x447 0x448 0x449>;
					bias-pull-up;
					input-enable;
				};

				rst-pins {
					input-schmitt-disable;
					input-disable;
					drive-strength = <0x0c>;
					pinmux = <0xff13003e>;
					slew-rate = <0x00>;
					bias-pull-up;
				};
			};

			hdmi_pins: hdmi-0 {
				phandle = <0x3f>;

				hdmi-cec-pins {
					pinmux = <0x50a080e>;
					bias-pull-up;
					input-enable;
				};

				hdmi-hpd-pins {
					bias-disable;
					pinmux = <0x800040f>;
					input-enable;
				};

				hdmi-scl-pins {
					pinmux = <0x60b0c00>;
					bias-pull-up;
					input-enable;
				};

				hdmi-sda-pins {
					pinmux = <0x70c1001>;
					bias-pull-up;
					input-enable;
				};
			};

			pwmdac_pins: pwmdac-0 {
				phandle = <0x1c>;

				pwmdac-pins {
					input-schmitt-disable;
					input-disable;
					drive-strength = <0x02>;
					bias-disable;
					pinmux = <0xff1c0021 0xff1d0022>;
					slew-rate = <0x00>;
				};
			};

			uart0_pins: uart0-0 {
				phandle = <0x12>;

				tx-pins {
					input-schmitt-disable;
					input-disable;
					drive-strength = <0x0c>;
					bias-disable;
					pinmux = <0xff140005>;
					slew-rate = <0x00>;
				};

				rx-pins {
					drive-strength = <0x02>;
					bias-disable;
					pinmux = <0xe000406>;
					input-schmitt-enable;
					slew-rate = <0x00>;
					input-enable;
				};
			};

			pcie1_pins: pcie1-0 {
				phandle = <0x48>;

				clkreq-pins {
					input-schmitt-disable;
					drive-strength = <0x02>;
					pinmux = <0xff00041d>;
					bias-pull-down;
					slew-rate = <0x00>;
					input-enable;
				};

				wake-pins {
					input-schmitt-disable;
					drive-strength = <0x02>;
					pinmux = <0xff000415>;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};

			i2c0_pins: i2c0-0 {
				phandle = <0x13>;

				i2c-pins {
					bias-disable;
					pinmux = <0x9001439 0xa00183a>;
					input-schmitt-enable;
					input-enable;
				};
			};

			i2c6_pins: i2c6-0 {
				phandle = <0x22>;

				i2c-pins {
					bias-disable;
					pinmux = <0x5600b810 0x5700bc11>;
					input-schmitt-enable;
					input-enable;
				};
			};

			pwm_pins: pwm-0 {
				phandle = <0x25>;

				pwm-pins {
					input-schmitt-disable;
					input-disable;
					drive-strength = <0x0c>;
					bias-disable;
					pinmux = <0xff18242e 0xff19283b>;
					slew-rate = <0x00>;
				};
			};

			pcie0_pins: pcie0-0 {
				phandle = <0x45>;

				clkreq-pins {
					input-schmitt-disable;
					drive-strength = <0x02>;
					pinmux = <0xff00041b>;
					bias-pull-down;
					slew-rate = <0x00>;
					input-enable;
				};

				wake-pins {
					input-schmitt-disable;
					drive-strength = <0x02>;
					pinmux = <0xff000420>;
					slew-rate = <0x00>;
					bias-pull-up;
					input-enable;
				};
			};
		};

		crypto: crypto@16000000 {
			clock-names = "hclk", "ahb";
			resets = <0x1e 0x03>;
			interrupts = <0x1c>;
			clocks = <0x1e 0x0f 0x1e 0x10>;
			dma-names = "tx", "rx";
			compatible = "starfive,jh7110-crypto";
			reg = <0x00 0x16000000 0x00 0x4000>;
			phandle = <0x6e>;
			dmas = <0x29 0x01 0x02 0x29 0x00 0x02>;
		};

		spi4: spi@12080000 {
			arm,primecell-periphid = <0x41022>;
			#address-cells = <0x01>;
			num-cs = <0x01>;
			clock-names = "sspclk", "apb_pclk";
			resets = <0x03 0x49>;
			interrupts = <0x35>;
			clocks = <0x03 0x87 0x03 0x87>;
			#size-cells = <0x00>;
			compatible = "arm,pl022", "arm,primecell";
			status = "disabled";
			reg = <0x00 0x12080000 0x00 0x10000>;
			phandle = <0x66>;
		};

		vout_subsystem: display-subsystem@29400000 {
			power-domains = <0x37 0x04>;
			#address-cells = <0x02>;
			dma-noncoherent;
			resets = <0x03 0x1a>;
			clocks = <0x03 0x3c>;
			#size-cells = <0x02>;
			compatible = "starfive,jh7110-vout-subsystem";
			ranges;
			reg = <0x00 0x29400000 0x00 0x200000>;
			phandle = <0x76>;

			hdmi_subsystem: hdmi@29590000 {
				compatible = "starfive,jh7110-hdmi-subsystem";
				reg = <0x00 0x29590000 0x00 0x4000>;
				phandle = <0x7a>;

				hdmi_controller: controller {
					pinctrl-names = "default";
					pinctrl-0 = <0x3f>;
					clock-names = "pclk", "mclk", "bclk", "pixel";
					resets = <0x3b 0x09>;
					interrupts = <0x63>;
					clocks = <0x3b 0x11 0x3b 0x0f 0x3b 0x10 0x3c>;
					compatible = "starfive,jh7110-inno-hdmi-controller";
					status = "okay";
					starfive,vout-syscon = <0x3e>;
					phys = <0x3c>;
					phandle = <0x7b>;

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							hdmi_in: endpoint {
								remote-endpoint = <0x40>;
								phandle = <0x3d>;
							};
						};

						hdmi_out_port: port@1 {
							reg = <0x01>;
							phandle = <0x7c>;

							hdmi_out_con: endpoint {
								remote-endpoint = <0x41>;
								phandle = <0x4d>;
							};
						};
					};
				};

				hdmi_phy: phy {
					clocks = <0x42>;
					#clock-cells = <0x00>;
					#phy-cells = <0x00>;
					compatible = "starfive,jh7110-inno-hdmi-phy";
					phandle = <0x3c>;
				};
			};

			vout_syscon: syscon@295b0000 {
				compatible = "starfive,jh7110-vout-syscon", "syscon";
				reg = <0x00 0x295b0000 0x00 0x10000>;
				phandle = <0x3e>;
			};

			voutcrg: clock-controller@295c0000 {
				power-domains = <0x37 0x04>;
				#reset-cells = <0x01>;
				clock-names = "vout_src", "vout_top_ahb", "vout_top_axi", "vout_top_hdmitx0_mclk", "i2stx0_bclk", "hdmitx0_pixelclk";
				resets = <0x03 0x2b>;
				clocks = <0x03 0x3a 0x03 0x3d 0x03 0x3e 0x03 0x3f 0x03 0xa5 0x3c>;
				#clock-cells = <0x01>;
				compatible = "starfive,jh7110-voutcrg";
				status = "okay";
				reg = <0x00 0x295c0000 0x00 0x10000>;
				phandle = <0x3b>;
			};

			dc8200: display@29400000 {
				clock-names = "core", "axi", "ahb", "pix0", "pix1";
				assigned-clocks = <0x3b 0x07 0x3b 0x08>;
